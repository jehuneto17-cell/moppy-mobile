{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moppy.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.moppy",
      "adaptiveIcon": {
        "backgroundColor": "#9473F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#9473F1"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Moppy usa sua localização pra mostrar a distância até os pedidos disponíveis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Moppy usa a galeria pra você enviar fotos de documentos e do serviço.",
          "cameraPermission": "O Moppy usa a câmera pra você tirar fotos de documentos, selfie e do serviço."
        }
      ],
      "@rnmapbox/maps",
      "./plugins/withAndroidPathCheck"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc703ce3-135f-440c-ae50-40f1fc471673"
      }
    },
    "owner": "jehu77"
  }
}
