{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/rewritetest$", "dest": "/home.html" },
    { "src": "^/pedido/([^/]+)/([^/]+)$", "dest": "/pedido/[id]/$2.html" },
    { "src": "^/pedido/([^/]+)$", "dest": "/pedido/[id]/index.html" },
    { "handle": "filesystem" },
    { "src": "^/(.*[^/])$", "dest": "/$1.html", "check": true }
  ]
}
